# Day 28: copy this to .env and fill in real values locally.
# .env is loaded by docker-compose via env_file — never commit the real .env.

# LLM provider (only needed if a service is switched from the local Ollama
# endpoint to a hosted API in main.py / rag_chatbot.py):
OPENAI_API_KEY=your-key-here
ANTHROPIC_API_KEY=your-key-here

# Frontend -> backend URL override (compose sets this automatically to
# http://backend:8000 in docker-compose.yml; only needed for local overrides).
API_URL=http://127.0.0.1:8000
